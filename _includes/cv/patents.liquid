{% comment %}
  Unified patent entry renderer for both formats
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="patent-item">
      <strong> {{ entry.name | markdownify | remove: '<p>' | remove: '</p>' }} - </strong>
      {{ entry.summary }}
    </div>
  {% endfor %}
</div>

<style>
  .patent-item {
    padding: 0.5rem 0;
  }
</style>
